<resources>
    <style name="tema_riesgos" parent="ThemeOverlay.Material3">
        <item name="colorPrimary">@color/color_principal</item>
        <item name="colorOnPrimary">@color/color_superficie</item>
        <item name="colorSurface">@color/color_superficie</item>
        <item name="colorOnSurface">@color/color_texto_principal</item>
        <item name="colorOnSurfaceVariant">@color/color_texto_secundario</item>
        <item name="colorOutline">@color/color_borde</item>
        <item name="android:fontFamily">sans</item>
        <item name="fontFamily">sans</item>
    </style>
    <style name="riesgos_texto" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/color_texto_principal</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="riesgos_titulo" parent="riesgos_texto">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="riesgos_tarjeta" parent="Widget.Material3.CardView.Outlined">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/espaciado_16</item>
        <item name="cardBackgroundColor">@color/color_superficie</item>
        <item name="cardCornerRadius">@dimen/radio_tarjeta</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/color_borde</item>
    </style>
    <style name="riesgos_boton_primario" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/altura_boton</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radio_boton</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="riesgos_boton_secundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/altura_boton</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/radio_boton</item>
        <item name="strokeColor">@color/color_borde</item>
        <item name="backgroundTint">@color/color_superficie</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
