<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.RA_App" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_principal</item>
        <item name="colorOnPrimary">@color/color_superficie</item>
        <item name="colorSecondary">@color/color_principal</item>
        <item name="colorOnSecondary">@color/color_superficie</item>
        <item name="colorSurface">@color/color_superficie</item>
        <item name="colorOnSurface">@color/color_texto_principal</item>
    </style>

    <style name="Theme.RA_App" parent="Base.Theme.RA_App" />

    <!-- Solo para LoginActivity: el formulario usa los widgets TextInput de Material Components. -->
    <style name="Theme.RA_App.Login" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/principal</item>
        <item name="colorPrimaryVariant">@color/principal</item>
        <item name="colorOnPrimary">@color/superficie</item>
        <item name="colorSecondary">@color/secundario</item>
        <item name="android:statusBarColor">@color/fondo</item>
        <item name="android:navigationBarColor">@color/fondo</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>