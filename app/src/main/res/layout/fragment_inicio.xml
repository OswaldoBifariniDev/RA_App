<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/alto_encabezado_aplicacion"
            android:background="@color/color_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/espaciado_grande"
            android:paddingEnd="@dimen/espaciado_medio">

            <ImageView
                android:layout_width="@dimen/tamano_marca_aplicacion"
                android:layout_height="@dimen/tamano_marca_aplicacion"
                android:background="@drawable/bg_marca"
                android:contentDescription="@string/descripcion_marca"
                android:padding="@dimen/espaciado_pequeno"
                android:src="@drawable/ic_marca" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaciado_pequeno"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/titulo_aplicacion"
                    android:textColor="@color/color_text"
                    android:textSize="@dimen/tamano_texto_tarjeta"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subtitulo_aplicacion"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/tamano_texto_secundario" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="@dimen/alto_estado_conexion"
                android:background="@drawable/bg_estado_sin_conexion"
                android:drawableStart="@drawable/ic_estado_sin_conexion"
                android:drawablePadding="@dimen/espaciado_minimo"
                android:gravity="center"
                android:paddingStart="@dimen/espaciado_pequeno"
                android:paddingEnd="@dimen/espaciado_pequeno"
                android:text="@string/estado_sin_conexion"
                android:textColor="@color/color_primary"
                android:textSize="@dimen/tamano_texto_secundario"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/alto_bienvenida"
            android:background="@color/color_surface"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="@dimen/espaciado_grande"
            android:paddingEnd="@dimen/espaciado_grande">

            <TextView
                android:id="@+id/txt_saludo_inicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_text"
                android:textSize="@dimen/tamano_texto_saludo"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_minimo"
                android:text="@string/mensaje_bienvenida"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/tamano_texto_cuerpo" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/alto_divisor"
            android:background="@color/color_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/espaciado_grande"
            android:paddingTop="@dimen/espaciado_medio"
            android:paddingEnd="@dimen/espaciado_grande"
            android:paddingBottom="@dimen/espaciado_grande">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/espaciado_pequeno"
                android:text="@string/encabezado_ayuda_emergencia"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/tamano_texto_secundario"
                android:textStyle="bold" />

            <ViewFlipper
                android:id="@+id/carrusel_ayuda_emergencia"
                android:layout_width="match_parent"
                android:layout_height="@dimen/alto_carrusel"
                android:background="@drawable/bg_carrusel"
                android:clickable="true"
                android:contentDescription="@string/descripcion_carrusel"
                android:measureAllChildren="false">

                <include layout="@layout/item_ayuda_emergencia" />
                <include layout="@layout/item_ayuda_emergencia" />
                <include layout="@layout/item_ayuda_emergencia" />
            </ViewFlipper>

            <LinearLayout
                android:id="@+id/fila_indicadores_carrusel"
                android:layout_width="match_parent"
                android:layout_height="@dimen/alto_fila_indicadores"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_anterior_carrusel"
                    android:layout_width="@dimen/alto_control_accesible"
                    android:layout_height="@dimen/alto_control_accesible"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/accion_consejo_anterior"
                    android:padding="@dimen/espaciado_medio"
                    android:src="@drawable/ic_flecha_izquierda"
                    android:tint="@color/color_primary" />

                <View
                    android:layout_width="@dimen/indicador_carrusel_seleccionado"
                    android:layout_height="@dimen/indicador_carrusel_normal"
                    android:layout_marginHorizontal="@dimen/espaciado_minimo"
                    android:background="@drawable/bg_indicador_seleccionado" />

                <View
                    android:layout_width="@dimen/indicador_carrusel_normal"
                    android:layout_height="@dimen/indicador_carrusel_normal"
                    android:layout_marginHorizontal="@dimen/espaciado_minimo"
                    android:background="@drawable/bg_indicador" />

                <View
                    android:layout_width="@dimen/indicador_carrusel_normal"
                    android:layout_height="@dimen/indicador_carrusel_normal"
                    android:layout_marginHorizontal="@dimen/espaciado_minimo"
                    android:background="@drawable/bg_indicador" />

                <ImageButton
                    android:id="@+id/btn_siguiente_carrusel"
                    android:layout_width="@dimen/alto_control_accesible"
                    android:layout_height="@dimen/alto_control_accesible"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/accion_consejo_siguiente"
                    android:padding="@dimen/espaciado_medio"
                    android:src="@drawable/ic_flecha_derecha"
                    android:tint="@color/color_primary" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_escanear_qr"
                android:layout_width="match_parent"
                android:layout_height="@dimen/alto_control_accesible"
                android:layout_marginTop="@dimen/espaciado_pequeno"
                android:text="@string/accion_escanear_qr"
                android:textColor="@color/color_surface"
                android:textSize="@dimen/tamano_texto_cuerpo"
                android:textStyle="bold"
                app:backgroundTint="@color/color_primary"
                app:icon="@drawable/ic_qr_code"
                app:iconGravity="textStart"
                app:iconTint="@color/color_surface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_tarjeta"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="40dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_fecha_evento"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dia_evento"
                        android:textColor="@color/color_warning"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mes_evento"
                        android:textColor="@color/color_warning"
                        android:textSize="8sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/etiqueta_evento"
                        android:textColor="@color/color_warning"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/titulo_evento"
                        android:textColor="@color/color_text"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detalle_evento"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_medio"
                android:background="@drawable/bg_aviso"
                android:gravity="top"
                android:orientation="horizontal"
                android:padding="@dimen/espaciado_medio">

                <ImageView
                    android:layout_width="@dimen/tamano_icono_informacion"
                    android:layout_height="@dimen/tamano_icono_informacion"
                    android:contentDescription="@string/descripcion_informacion"
                    android:src="@drawable/ic_informacion" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espaciado_pequeno"
                    android:layout_weight="1"
                    android:text="@string/mensaje_aviso_emergencia"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/tamano_texto_secundario" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
