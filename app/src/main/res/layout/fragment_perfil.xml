<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espaciado_extra_grande">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/perfil_titulo"
            android:textColor="@color/color_text"
            android:textSize="@dimen/tamano_texto_titulo"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaciado_pequeno"
            android:text="@string/perfil_descripcion"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/tamano_texto_cuerpo" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaciado_extra_grande"
            android:background="@drawable/bg_aviso"
            android:padding="@dimen/espaciado_grande"
            android:text="@string/perfil_aviso_demostracion"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/tamano_texto_cuerpo" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaciado_extra_grande"
            android:background="@drawable/bg_tarjeta"
            android:orientation="vertical"
            android:padding="@dimen/espaciado_grande">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_extra_grande"
                android:labelFor="@id/txt_nombre_perfil"
                android:text="@string/perfil_nombre"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/tamano_texto_cuerpo" />
            <TextView
                android:id="@+id/txt_nombre_perfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_minimo"
                android:textColor="@color/color_text"
                android:textIsSelectable="true"
                android:textSize="@dimen/tamano_texto_tarjeta" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_extra_grande"
                android:labelFor="@id/txt_apellido_perfil"
                android:text="@string/perfil_apellido"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/tamano_texto_cuerpo" />
            <TextView
                android:id="@+id/txt_apellido_perfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_minimo"
                android:textColor="@color/color_text"
                android:textIsSelectable="true"
                android:textSize="@dimen/tamano_texto_tarjeta" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_extra_grande"
                android:labelFor="@id/txt_correo_perfil"
                android:text="@string/etiqueta_correo"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/tamano_texto_cuerpo" />
            <TextView
                android:id="@+id/txt_correo_perfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_minimo"
                android:textColor="@color/color_text"
                android:textIsSelectable="true"
                android:textSize="@dimen/tamano_texto_tarjeta" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

