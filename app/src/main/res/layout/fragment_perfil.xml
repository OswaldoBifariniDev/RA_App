<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:orientation="vertical"
    tools:context=".fragment.PerfilFragment"
    tools:theme="@style/Theme.RA_App">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/alto_encabezado_perfil"
        android:background="@color/color_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_volver_inicio"
            android:layout_width="@dimen/alto_control_accesible"
            android:layout_height="@dimen/alto_control_accesible"
            android:layout_marginStart="@dimen/espaciado_pequeno"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/accion_volver_inicio"
            android:padding="@dimen/espaciado_medio"
            android:src="@drawable/ic_flecha_atras"
            app:tint="@color/color_surface" />

        <TextView
            android:id="@+id/txt_titulo_perfil"
            android:layout_width="74dp"
            android:layout_height="31dp"
            android:layout_marginStart="@dimen/espaciado_pequeno"
            android:fontFamily="sans"
            android:text="@string/perfil_titulo"
            android:textColor="@color/color_surface"
            android:textSize="@dimen/tamano_texto_saludo"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/espaciado_medio"
        android:paddingTop="@dimen/espaciado_medio">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/espaciado_grande"
            android:paddingEnd="@dimen/espaciado_grande">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tarjeta_perfil"
                android:clipToOutline="true"
                tools:targetApi="21">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/alto_portada_perfil"
                    android:background="@drawable/bg_portada_perfil"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/espaciado_grande">

                    <FrameLayout
                        android:layout_width="@dimen/tamano_foto_perfil"
                        android:layout_height="@dimen/tamano_foto_perfil"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/espaciado_minimo"
                        android:background="@drawable/bg_marco_foto_perfil"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:padding="@dimen/espaciado_minimo">

                            <ImageView
                                android:id="@+id/img_foto_perfil"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_foto_perfil"
                                android:clipToOutline="true"
                                android:contentDescription="@string/descripcion_foto_perfil"
                                android:scaleType="centerCrop"
                                android:src="@drawable/foto_perfil_demo"
                                tools:targetApi="21" />

                            <FrameLayout
                                android:id="@+id/btn_cambiar_foto_perfil"
                                android:layout_width="@dimen/alto_control_accesible"
                                android:layout_height="@dimen/alto_control_accesible"
                                android:layout_gravity="bottom|end"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:contentDescription="@string/accion_cambiar_foto_perfil"
                                android:focusable="true">

                                <ImageView
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:layout_gravity="center"
                                    android:background="@drawable/bg_boton_camara_perfil"
                                    android:contentDescription="@null"
                                    android:padding="@dimen/espaciado_pequeno"
                                    android:src="@drawable/ic_camara_perfil" />
                            </FrameLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txt_nombre_perfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espaciado_pequeno"
                        android:gravity="center"
                        android:paddingStart="@dimen/espaciado_grande"
                        android:paddingEnd="@dimen/espaciado_grande"
                        android:textColor="@color/color_text"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="Ana Pérez" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espaciado_grande"
                        android:layout_marginTop="@dimen/espaciado_medio"
                        android:layout_marginEnd="@dimen/espaciado_grande"
                        android:background="@drawable/bg_descripcion_perfil"
                        android:gravity="center"
                        android:lineSpacingExtra="@dimen/espaciado_minimo"
                        android:padding="@dimen/espaciado_medio"
                        android:text="@string/perfil_frase"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="@dimen/tamano_texto_cuerpo" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_grande"
                android:background="@drawable/bg_tarjeta_perfil"
                android:orientation="vertical"
                android:padding="@dimen/espaciado_medio">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/alto_encabezado_info_perfil"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txt_titulo_info_perfil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/perfil_info_titulo"
                        android:textColor="@color/color_text"
                        android:textSize="@dimen/tamano_texto_destacado"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/alto_divisor"
                    android:layout_marginTop="@dimen/espaciado_minimo"
                    android:background="@color/color_border"
                    android:importantForAccessibility="no" />

                <include
                    android:id="@+id/dato_nombre_completo"
                    layout="@layout/item_perfil_dato_nombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/alto_divisor"
                    android:layout_marginTop="@dimen/espaciado_minimo"
                    android:background="@color/color_border"
                    android:importantForAccessibility="no" />

                <include
                    android:id="@+id/dato_correo"
                    layout="@layout/item_perfil_dato_correo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/alto_divisor"
                    android:layout_marginTop="@dimen/espaciado_minimo"
                    android:background="@color/color_border"
                    android:importantForAccessibility="no" />

                <include
                    android:id="@+id/dato_descripcion"
                    layout="@layout/item_perfil_dato_descripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cerrar_sesion"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/alto_boton_perfil"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/espaciado_grande"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="320dp"
                android:maxWidth="360dp"
                android:text="@string/perfil_cerrar_sesion"
                android:textAllCaps="false"
                android:textColor="@color/color_surface"
                android:textSize="@dimen/tamano_texto_tarjeta"
                android:textStyle="bold"
                app:backgroundTint="@color/color_error"
                app:cornerRadius="@dimen/radio_boton"
                app:icon="@drawable/ic_cerrar_sesion"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/espaciado_pequeno"
                app:iconTint="@color/color_surface" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
