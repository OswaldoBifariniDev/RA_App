<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/espaciado_grande">

    <ImageView
        android:id="@+id/img_ayuda_emergencia"
        android:layout_width="@dimen/tamano_icono_ayuda"
        android:layout_height="@dimen/tamano_icono_ayuda"
        android:background="@drawable/bg_icono_secundario"
        android:contentDescription="@string/descripcion_imagen_ayuda"
        android:padding="@dimen/espaciado_medio" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espaciado_grande"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/etiqueta_consejo"
            android:textColor="@color/color_primary"
            android:textSize="@dimen/tamano_texto_detalle"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_titulo_ayuda_emergencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaciado_minimo"
            android:textColor="@color/color_text"
            android:textSize="@dimen/tamano_texto_tarjeta"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_detalle_ayuda_emergencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaciado_minimo"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/tamano_texto_secundario" />
    </LinearLayout>
</LinearLayout>
