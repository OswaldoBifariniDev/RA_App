<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/txt_titulo_registro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_registro"
            android:textColor="@color/color_texto_principal"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="32dp"/>

        <!-- Campo Nombre -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/etiqueta_nombre"
            android:textColor="@color/color_texto_secundario"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/et_nombre_apellido"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_textfield"
            android:paddingHorizontal="16dp"
            android:hint="Escribe tu nombre"
            android:inputType="textPersonName"
            android:layout_marginBottom="16dp"/>

        <!-- Campo Identificación -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/etiqueta_identificacion"
            android:textColor="@color/color_texto_secundario"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/et_identificacion"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_textfield"
            android:paddingHorizontal="16dp"
            android:hint="Escribe tu cédula o pasaporte"
            android:inputType="number"
            android:layout_marginBottom="16dp"/>

        <!-- Campo Correo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/etiqueta_correo"
            android:textColor="@color/color_texto_secundario"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/et_correo_electronico"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_textfield"
            android:paddingHorizontal="16dp"
            android:hint="correo@ejemplo.com"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="16dp"/>

        <!-- Campo Contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/etiqueta_contrasena"
            android:textColor="@color/color_texto_secundario"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/et_contrasena"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_textfield"
            android:paddingHorizontal="16dp"
            android:hint="Mínimo 6 caracteres"
            android:inputType="textPassword"
            android:layout_marginBottom="24dp"/>

        <!-- Botón Principal -->
        <Button
            android:id="@+id/btn_registrar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/btn_registrar"
            android:textColor="@color/color_superficie"
            android:backgroundTint="@color/color_principal"
            android:layout_marginBottom="16dp"/>

        <!-- Enlace a Login -->
        <TextView
            android:id="@+id/txt_ir_login"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/txt_ir_login"
            android:textColor="@color/color_principal"
            android:gravity="center"
            android:padding="8dp"/>

    </LinearLayout>
</ScrollView>